# WarmBase example environment (copy to .env and fill secrets)
# Do NOT commit a real `.env` with secrets. Keep `.env` local and out of version control.
#
# - `VITE_` prefixed variables are intended for the browser (public/anon keys).
# - Server-only secrets (e.g. `SUPABASE_SERVICE_ROLE_KEY`) must never be exposed to the client.

# Supabase
SUPABASE_URL=
VITE_SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# App
APP_BASE_URL=http://localhost:5174

# Other secrets (local example)
CRON_SECRET=
RESEND_WEBHOOK_SECRET=
FIRECRAWL_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
KIMI_API_KEY=
ENCRYPTION_KEY=
