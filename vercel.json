{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist/client"
      }
    },
    {
      "src": "api/ssr.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/ssr",
      "dest": "/api/ssr"
    },
    {
      "src": "/(.*)",
      "dest": "/api/ssr"
    }
  ],
  "crons": [
    {
      "path": "/api/public/cron/autonomous",
      "schedule": "0 * * * *"
    }
  ]
}
