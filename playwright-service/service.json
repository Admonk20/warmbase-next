{
  "name": "playwright-service",
  "type": "docker",
  "dockerfile": "../Dockerfile.playwright",
  "healthcheck": {
    "path": "/healthz",
    "interval": 10
  },
  "env": [
    { "key": "PLAYWRIGHT_API_KEY", "required": false },
    { "key": "MAX_CONCURRENT_PAGES", "required": false, "default": "2" },
    { "key": "RATE_LIMIT_MAX", "required": false, "default": "10" },
    { "key": "RATE_LIMIT_WINDOW_MS", "required": false, "default": "60000" }
  ],
  "resources": {
    "memory": "1024"
  }
}
